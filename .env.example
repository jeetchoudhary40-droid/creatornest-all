# ── Site & API URLs (Change to your VPS domain when deploying) ──
NEXT_PUBLIC_SITE_URL=https://creatornest.in
NEXT_PUBLIC_API_URL=https://api.creatornest.in/api/v1

# ── Email Forwarding (Gmail SMTP) ────────────────────────────
CONTACT_EMAIL=hellocreatornest@gmail.com
GMAIL_USER=hellocreatornest@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# ── Supabase (optional for hosted DB) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── YouTube Data API v3 ──────────────────────────────────────
# Get from: https://console.cloud.google.com → Enable "YouTube Data API v3"
# Free tier: 10,000 units/day (channel stats = 1 unit each)
YOUTUBE_API_KEY=AIza...

# Google OAuth (for creator YouTube Analytics connect)
# Get from: Google Cloud Console → OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Instagram / Meta Graph API ───────────────────────────────
# Get from: https://developers.facebook.com → My Apps → Create App
# Requires: instagram_basic, instagram_manage_insights permissions
META_APP_ID=1234567890
META_APP_SECRET=your-meta-app-secret

# ── Gemini AI (for AI enrichment) ───────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Free tier: 60 requests/minute (more than enough for enrichment)
GEMINI_API_KEY=AIza...

# ── Security ─────────────────────────────────────────────────
# 32-char random string for encrypting OAuth tokens in DB
# Generate: openssl rand -hex 16
TOKEN_ENCRYPTION_KEY=your-32-char-random-string-here

# ── Supabase Edge Functions (set in Supabase Dashboard → Edge Functions → Secrets) ─
# Also set these as Supabase secrets for the cron functions:
# NEXTJS_BASE_URL=https://your-production-domain.com
# YOUTUBE_API_KEY=(same as above)
# GEMINI_API_KEY=(same as above)
# META_APP_SECRET=(same as above)
